            "value": "System default"
          }
        }
      }
    },
    "Teilnehmer informieren.": {
      "comment": "Suggestion panel: the reminder under the buttons. Recording a meeting without saying so is illegal in most of Europe.",
      "extractionState": "manual",
      "localizations": {
