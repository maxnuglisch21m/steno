          "stringUnit": {
            "state": "translated",
            "value": "System audio"
          }
        }
      }
    },
    "Systemaudio-Prüfung ergab Status %d.": {
      "comment": "Shown when the process tap probe failed for a reason that is not a permission answer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system audio check returned status %d."
          }
