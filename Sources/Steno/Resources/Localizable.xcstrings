{
  "sourceLanguage": "de",
  "strings": {
    "%.1f %%": {
      "comment": "Percentage value next to a screenshot change-threshold slider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f %%"
          }
        }
      }
    },
    "%@ %d %%": {
      "comment": "Model status line with a percentage, e.g. 'Sprachmodell wird geladen … 42 %'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %d %%"
          }
        }
      }
    },
    "%@ (noch %d)": {
      "comment": "Transcription step label with the number of meetings still queued behind it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%d more)"
          }
        }
      }
    },
    "%@ wird kompiliert … (beim ersten Mal Minuten)": {
      "comment": "Model status: Core ML is compiling one named model for this Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiling %@ … (minutes, the first time)"
          }
        }
      }
    },
    "%@ · %d min": {
      "comment": "Notification body: the meeting folder and its length in minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %d min"
          }
        }
      }
    },
    "%d px": {
      "comment": "Pixel value next to the maximum image edge stepper.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d px"
          }
        }
      }
    },
    "%d s": {
      "comment": "Seconds value next to a stepper.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d s"
          }
        }
      }
    },
    "%d unterbrochene Meetings konnten nicht gerettet werden.": {
      "comment": "Menu status line after the launch recovery scan found interrupted meetings with no usable audio. Plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d interrupted meetings could not be salvaged."
          }
        }
      }
    },
    "%d unterbrochene Meetings werden nachverarbeitet": {
      "comment": "Menu status line after the launch recovery scan picked up interrupted meetings. Plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d interrupted meetings are being processed"
          }
        }
      }
    },
    "1 unterbrochenes Meeting konnte nicht gerettet werden.": {
      "comment": "Menu status line after the launch recovery scan found one interrupted meeting with no usable audio.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 interrupted meeting could not be salvaged."
          }
        }
      }
    },
    "1 unterbrochenes Meeting wird nachverarbeitet": {
      "comment": "Menu status line after the launch recovery scan picked up one interrupted meeting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 interrupted meeting is being processed"
          }
        }
      }
    },
    "AAC (m4a) — klein": {
      "comment": "Audio archive format option.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC (m4a) — small"
          }
        }
      }
    },
    "ASR-Version": {
      "comment": "Settings label: which Parakeet checkpoint to use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech model version"
          }
        }
      }
    },
    "Abbrechen": {
      "comment": "Button that dismisses a dialog without recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Ablageordner": {
      "comment": "Settings label: the root folder recordings go into.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording folder"
          }
        }
      }
    },
    "Allgemein": {
      "comment": "Settings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "Anker-Frame-Intervall": {
      "comment": "Settings label: how often a display is captured regardless of change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor frame interval"
          }
        }
      }
    },
    "Archiv": {
      "comment": "Transcription step 4 of 4: transcoding the audio archive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive"
          }
        }
      }
    },
    "Audio-Archivformat": {
      "comment": "Settings label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio archive format"
          }
        }
      }
    },
    "Auf Vorgaben zurücksetzen": {
      "comment": "Button that restores the default watchlist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to defaults"
          }
        }
      }
    },
    "Aufgenommen wird immer verlustfreies WAV. Umgewandelt wird erst, wenn das Transkript steht — die Qualität der Erkennung hängt also nicht daran.": {
      "comment": "Explains the archive format setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is always lossless WAV. Conversion happens only after the transcript is written, so recognition quality does not depend on this."
          }
        }
      }
    },
    "Aufnahme": {
      "comment": "Settings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        }
      }
    },
    "Aufnahme abgebrochen, kein Audio": {
      "comment": "meta.json error for a recording that was interrupted before any audio reached the disk.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording interrupted, no audio"
          }
        }
      }
    },
    "Aufnahme fehlgeschlagen": {
      "comment": "Notification title when a recording ended badly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording failed"
          }
        }
      }
    },
    "Aufnahme läuft · %@ · %@": {
      "comment": "Non-interactive status line at the top of the menu: mode, then mm:ss.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording · %@ · %@"
          }
        }
      }
    },
    "Aufnahme nicht möglich": {
      "comment": "Title of the alert shown when Voice Isolation blocks an on-site recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot record"
          }
        }
      }
    },
    "Aufnahme starten": {
      "comment": "Button that confirms the speaker-count dialog and starts recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Recording"
          }
        }
      }
    },
    "Aufnahme stoppen": {
      "comment": "Menu item, only shown while recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop recording"
          }
        }
      }
    },
    "Aufnehmen": {
      "comment": "Suggestion panel: the button that starts the recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record"
          }
        }
      }
    },
    "Aus „Weekly Sync“ wird 2026-09-09_1430_Teams_Weekly-Sync.": {
      "comment": "Example for the title-in-folder-name setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Weekly Sync” becomes 2026-09-09_1430_Teams_Weekly-Sync."
          }
        }
      }
    },
    "Auswählen": {
      "comment": "Confirmation button of the folder picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        }
      }
    },
    "Auswählen …": {
      "comment": "Button that opens the folder picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose…"
          }
        }
      }
    },
    "Auto-Stop-Verzögerung": {
      "comment": "Settings label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-stop delay"
          }
        }
      }
    },
    "Automatisch": {
      "comment": "Speaker-count option: let diarization decide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        }
      }
    },
    "Automatisch gestoppt: %@ nutzt das Mikrofon nicht mehr.": {
      "comment": "Menu notice after auto-stop. %@ is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped automatically: %@ is no longer using the microphone."
          }
        }
      }
    },
    "Automatisch nach Updates suchen": {
      "comment": "Settings toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically"
          }
        }
      }
    },
    "Beenden": {
      "comment": "Menu bar item that quits Steno.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "Bei der Anmeldung starten": {
      "comment": "Settings toggle for the login item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at login"
          }
        }
      }
    },
    "Berechtigung fehlt: %@": {
      "comment": "Why a recording cannot start; %@ is the permission name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission missing: %@"
          }
        }
      }
    },
    "Bildschirmaufnahme": {
      "comment": "Permission name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen recording"
          }
        }
      }
    },
    "Breites Spektrum": {
      "comment": "Microphone mode name, as Control Centre calls it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wide Spectrum"
          }
        }
      }
    },
    "Bundle-ID": {
      "comment": "Watchlist table column and text field placeholder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID"
          }
        }
      }
    },
    "Das Audio-Archiv ließ sich nicht schreiben: %@": {
      "comment": "Error when the audio transcode failed. The recording is kept as WAV.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio archive could not be written: %@"
          }
        }
      }
    },
    "Das Audiosystem antwortet nicht. Bitte den Mac neu starten oder `sudo killall coreaudiod` ausführen.": {
      "comment": "Shown when a recorder does not answer within 15 seconds, i.e. the audio daemon is wedged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio system is not responding. Restart the Mac, or run `sudo killall coreaudiod`."
          }
        }
      }
    },
    "Das Display mit dem Mauszeiger wird häufiger gesichert — dort passiert das Meeting.": {
      "comment": "Explains the two screenshot intervals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display holding the pointer is captured more often — that is where the meeting is happening."
          }
        }
      }
    },
    "Das Eingabegerät liefert keine Kanäle.": {
      "comment": "Shown when the selected input device reports no audio channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input device reports no channels."
          }
        }
      }
    },
    "Das Eingabegerät „%@“ ist verschwunden. Die Aufnahme wurde beendet.": {
      "comment": "Shown when the selected microphone was unplugged during a recording. %@ is the device name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input device “%@” disappeared. The recording has been stopped."
          }
        }
      }
    },
    "Das Mikrofon ließ sich nicht öffnen: %@": {
      "comment": "Shown when the audio engine refused to start. %@ is the technical detail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not be opened: %@"
          }
        }
      }
    },
    "Das gemeinsame Audiogerät ließ sich nicht anlegen: %@": {
      "comment": "The aggregate device holding the microphone and the tap could not be created.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combined audio device could not be created: %@"
          }
        }
      }
    },
    "Das ist keine Bundle-ID. Erwartet wird etwas wie com.microsoft.teams2.": {
      "comment": "Validation error when adding a watchlist entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a bundle ID. Something like com.microsoft.teams2 is expected."
          }
        }
      }
    },
    "Das letzte Meeting wird noch verarbeitet.": {
      "comment": "Why a recording cannot start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last meeting is still being processed."
          }
        }
      }
    },
    "Der Ablageordner „%@“ ließ sich nicht anlegen: %@": {
      "comment": "Error; first %@ is the path, second the system reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording folder “%@” could not be created: %@"
          }
        }
      }
    },
    "Der Download läuft bereits.": {
      "comment": "Help text on the disabled model download button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download is already running."
          }
        }
      }
    },
    "Der Mac ist eingeschlafen. Die Aufnahme wurde beendet.": {
      "comment": "Menu notice when sleep ended a recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac went to sleep. The recording was stopped."
          }
        }
      }
    },
    "Der Meeting-Ordner ließ sich nicht anlegen: %@": {
      "comment": "Error; %@ is the system reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting folder could not be created: %@"
          }
        }
      }
    },
    "Der Modell-Download läuft bereits.": {
      "comment": "Error when a second model download is started while one runs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model download is already running."
          }
        }
      }
    },
    "Der System-Audio-Mitschnitt ließ sich nicht einrichten: %@": {
      "comment": "The Core Audio process tap could not be created.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio capture could not be set up: %@"
          }
        }
      }
    },
    "Deutsch": {
      "comment": "Transcription language option: German.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German"
          }
        }
      }
    },
    "Die Audioaufnahme ließ sich nicht starten: %@": {
      "comment": "The aggregate device's I/O proc could not be created or started.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio recording could not be started: %@"
          }
        }
      }
    },
    "Die Audiodatei des Meetings fehlt.": {
      "comment": "Transcription error: audio.wav is not in the meeting folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting's audio file is missing."
          }
        }
      }
    },
    "Die Audiodatei enthält keine Aufnahme.": {
      "comment": "Transcription error: the WAV has a header but no samples.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio file contains no recording."
          }
        }
      }
    },
    "Die Audiodatei ließ sich nicht auf 16 kHz umrechnen.": {
      "comment": "Transcription error: resampling to the models' sample rate failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio file could not be resampled to 16 kHz."
          }
        }
      }
    },
    "Die Audiodatei ließ sich nicht schreiben: %@": {
      "comment": "Shown when writing audio.wav failed, a full volume being the usual cause. %@ is the technical detail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio file could not be written: %@"
          }
        }
      }
    },
    "Die Aufnahme ist mit %.1f s zu kurz für die Spracherkennung.": {
      "comment": "Transcription error: the recognizer needs at least 300 ms of audio.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At %.1f s the recording is too short for speech recognition."
          }
        }
      }
    },
    "Die Aufnahme wurde vom System beendet: %@": {
      "comment": "Shown when the audio engine stopped and would not restart. %@ is the technical detail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system stopped the recording: %@"
          }
        }
      }
    },
    "Die Kanalaufteilung des Audiogeräts ist unerwartet. Die Aufnahme wurde nicht gestartet.": {
      "comment": "The aggregate device reported a channel layout the recorder cannot map to two channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio device reports an unexpected channel layout. The recording was not started."
          }
        }
      }
    },
    "Die Modelle fehlen noch. Die Verarbeitung wartet.": {
      "comment": "Menu notice when a meeting is queued but the transcription models are not installed yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The models are not installed yet. Processing is waiting."
          }
        }
      }
    },
    "Die Sprachmodelle sind nicht geladen.": {
      "comment": "Transcription error: speech recognition was used before its models were loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech models are not loaded."
          }
        }
      }
    },
    "Die Sprechertrennung findet die Zahl selbst. Wenn du sie kennst, wird sie zuverlässiger.": {
      "comment": "Body of the speaker-count dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker separation finds the number by itself. If you know it, it gets more reliable."
          }
        }
      }
    },
    "Die Sprechertrennung ist nicht geladen.": {
      "comment": "Transcription error: diarization was used before its models were loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker separation is not loaded."
          }
        }
      }
    },
    "Die Verarbeitung ist dreimal fehlgeschlagen und wurde aufgegeben.": {
      "comment": "Transcription error after the third failed attempt on one folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing failed three times and was given up on."
          }
        }
      }
    },
    "Die erwartete Sprache des Meetings. Sie hilft der Erkennung, Wörter im richtigen Schriftsystem zu wählen. „Automatisch“ überlässt die Entscheidung dem Modell.": {
      "comment": "Explanatory footnote under the transcription language picker in the settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language the meeting is expected to be in. It helps recognition pick words in the right script. “Automatic” leaves the decision to the model."
          }
        }
      }
    },
    "Die meta.json des Meetings ist unlesbar.": {
      "comment": "Transcription error: the folder's meta.json could not be decoded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
