    "Wie viele Personen sind im Raum?": {
      "comment": "Title of the optional speaker-count dialog before an on-site recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many people are in the room?"
          }
        }
      }
    },
    "Zu diesem Meeting gibt es keine Audiodatei.": {
      "comment": "Transcription error: the folder holds no audio.wav.",
      "extractionState": "manual",
