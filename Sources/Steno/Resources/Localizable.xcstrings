        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting has no audio file."
          }
        }
      }
    },
    "Zu wenig Speicherplatz: nur noch %@ frei.": {
      "comment": "Why a recording cannot start; %@ is a formatted byte count.",
