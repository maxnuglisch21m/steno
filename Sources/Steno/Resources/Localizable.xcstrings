    "Updates": {
      "comment": "Settings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Updates kommen über GitHub-Releases, werden mit einem eigenen Schlüssel signiert und einmal täglich gesucht. Heruntergeladen und installiert wird nur, was du bestätigst.": {
      "comment": "Explanation under the update settings when updates are configured.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates come from GitHub releases, are signed with a key of their own, and are looked for once a day. Nothing is downloaded or installed without your confirmation."
          }
        }
      }
    },
    "Verarbeitung": {
      "comment": "Label of the processing phase.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing"
          }
        }
      }
    },
    "Version": {
      "comment": "Settings label above the build summary.",
