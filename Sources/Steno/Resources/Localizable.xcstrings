    "Aufgenommen wird immer verlustfreies WAV. Umgewandelt wird erst, wenn das Transkript steht — die Qualität der Erkennung hängt also nicht daran.": {
      "comment": "Explains the archive format setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is always lossless WAV. Conversion happens only after the transcript is written, so recognition quality does not depend on this."
          }
        }
      }
    },
    "Aufnahme": {
      "comment": "Settings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        }
      }
    },
    "Aufnahme läuft · %@ · %@": {
